module half_adder(
    input a,b,
    output s,c
    );
    assign s=a^b;
    assign c=a&b;
endmodule

module full_adder(
input a,b,cin,
output s,cout
);
wire t1,t2,t3;

half_adder h1(.a(a),.b(b),.c(t1),.s(t2));
half_adder h2(.a(t1),.b(cin),.c(t3),.s(s));

assign cout=t1|t3;
endmodule

